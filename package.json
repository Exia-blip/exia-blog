{
  "name": "exia-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "db:init": "wrangler d1 execute blog-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute blog-db --local --file=./schema.sql",
    "tail": "wrangler tail",
    "test": "node scripts/test-md.mjs && node scripts/test-security.mjs && node scripts/test-antispam.mjs && node scripts/test-routes.mjs && node scripts/test-copy-notice.mjs && node scripts/verify-copy.mjs && node scripts/test-seo-series.mjs && node scripts/test-comment-ssr.mjs",
    "cards": "node scripts/gen-cards.mjs",
    "shots": "node scripts/shot.mjs",
    "check:ld": "node scripts/check-ld.mjs",
    "verify:a11y": "node scripts/verify-a11y-perf.mjs",
    "exp:css": "node scripts/exp-css-split.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1",
    "wrangler": "^4.159.0"
  }
}
