{
  "name": "exia-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "db:init": "wrangler d1 execute blog-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute blog-db --local --file=./schema.sql",
    "tail": "wrangler tail",
    "test": "node scripts/test-md.mjs && node scripts/test-security.mjs && node scripts/test-antispam.mjs && node scripts/test-routes.mjs && node scripts/test-copy-notice.mjs && node scripts/verify-copy.mjs && node scripts/test-seo-series.mjs && node scripts/test-comment-ssr.mjs && node scripts/test-stats.mjs && node scripts/test-token.mjs && node scripts/test-webhook.mjs && node scripts/test-setup.mjs",
    "cards": "node scripts/gen-cards.mjs",
    "shots": "node scripts/shot.mjs",
    "check:ld": "node scripts/check-ld.mjs",
    "verify:a11y": "node scripts/verify-a11y-perf.mjs",
    "exp:css": "node scripts/exp-css-split.mjs",
    "make:variants": "node scripts/make-variants.mjs",
    "variants:check": "node scripts/make-variants.mjs --check",
    "preflight": "node scripts/check-env.mjs",
    "setup:webhook": "node scripts/setup.mjs webhook",
    "setup:turnstile": "node scripts/setup.mjs turnstile",
    "setup:umami": "node scripts/setup.mjs umami",
    "verify:umami": "node scripts/verify-umami.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.35.5",
    "wrangler": "^4.159.0"
  }
}
