{
  "name": "exia-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "db:init": "wrangler d1 execute blog-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute blog-db --local --file=./schema.sql",
    "tail": "wrangler tail",
    "test": "node scripts/test-md.mjs && node scripts/test-security.mjs && node scripts/test-antispam.mjs && node scripts/test-routes.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.159.0"
  }
}
