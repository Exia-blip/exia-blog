node_modules/
.wrangler/
# 本地密钥文件。这行不能删：文件里有 LIVE_SESSION_SECRET（线上现役 SESSION_SECRET 的副本），
# 删了下次 git add -A 就会把线上会话密钥推进 public 仓库；CF secrets 只可写不可读，泄漏后只能轮换。
.dev.vars
.DS_Store
*.log

# Cloudflare API Token（本地凭据，别提交）
.cf-token

# 视觉回归截图（本地产物，不入库）
shots/
scripts/.cards-input.json

# 工具链工作目录（本地笔记、自动化记忆），属于本机状态，不该进仓库
.workbuddy/

# 临时导出：调试时把模板吐成 *.tmp.out.mjs 看过，别跟着提交
*.tmp.out.mjs
*.tmp
.tmp-*
!.tmp-*.md.example

# D1 备份导出（含文章全文，不进仓库）
backups/*.sql
backups/*.sqlite
