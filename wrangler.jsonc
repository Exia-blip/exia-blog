{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exia-blog",
  "main": "src/index.js",
  "compatibility_date": "2024-11-06",

  // 静态资源：public/ 下的文件优先命中，未命中的交给 Worker 处理 /:slug
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-db",
      "database_id": "REPLACE_WITH_YOUR_D1_ID"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "blog-images"
    }
  ],

  // 友链每 20 分钟巡检一次
  "triggers": {
    "crons": ["*/20 * * * *"]
  },

  "observability": {
    "enabled": true
  },

  "vars": {
    "SITE_NAME": "Exia Blog",
    "SITE_DESC": "写字的地方",
    // OAuth 回调地址，必须是 https://你的域名/auth/callback
    "OAUTH_REDIRECT": "https://example.com/auth/callback",
    "GITHUB_CLIENT_ID": "REPLACE_ME",
    // R2 公开访问域名，留空则走 /img/ 代理
    "R2_PUBLIC_BASE": ""
    // 以下 secrets 用 wrangler secret put 写入：
    // SESSION_SECRET / GITHUB_CLIENT_SECRET
    // R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET_NAME
    // WEBHOOK_URL
  }
}
