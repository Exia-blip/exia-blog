{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exia-blog",
  "main": "src/index.js",
  "compatibility_date": "2024-11-06",

  // 静态资源：public/ 下的文件优先命中，未命中的交给 Worker 处理 /:slug
  // run_worker_first：HTML 也走 Worker，好把站点默认风格注入 <head>（首访不闪）
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-db",
      "database_id": "2568eaf1-80f6-4a40-bc2c-9e361ff32d6b"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "blog-images"
    }
  ],

  // 文章 AI 摘要（Workers AI）；也可改用 AI_API_KEY 走外部 OpenAI 兼容接口
  "ai": {
    "binding": "AI"
  },

  // 友链每 20 分钟巡检一次
  "triggers": {
    "crons": ["*/20 * * * *"]
  },

  "observability": {
    "enabled": true
  },

  "vars": {
    "SITE_NAME": "Exia Blog",
    "SITE_DESC": "写字的地方",
    // 默认风格：paper | ink | forest | ocean | plum | mono
    "SITE_THEME": "paper",
    // 默认外观：auto（跟随系统）| light | dark
    "SITE_MODE": "auto",
    // OAuth 回调地址，必须是 https://你的域名/auth/callback
    "OAUTH_REDIRECT": "https://exia-blog.meitu.workers.dev/auth/callback",
    "GITHUB_CLIENT_ID": "Ov23liBYcJtW33DLooEd",
    // R2 公开访问域名，留空则走 /img/ 代理
    "R2_PUBLIC_BASE": ""
    // 以下 secrets 用 wrangler secret put 写入：
    // SESSION_SECRET / GITHUB_CLIENT_SECRET
    // R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET_NAME
    // WEBHOOK_URL
  }
}
